# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/singuage?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secret-access-token-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# External APIs
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
DEEPL_API_KEY=your-deepl-api-key
YOUTUBE_API_KEY=your-youtube-api-key

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Features
ENABLE_RATE_LIMITING=true
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
