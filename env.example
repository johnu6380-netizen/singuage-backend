# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DATABASE_URL="" #Keep this secret and NEVER expose to the frontend or commit it to public source control.

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secret-access-token-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# External APIs
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
DEEPL_API_KEY=your-deepl-api-key
YOUTUBE_API_KEY=your-youtube-api-key

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Features
ENABLE_RATE_LIMITING=true
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Stripe (backend-only secrets)
# Secret API key for server-side Stripe operations. This must only be used on the server.
# Configure these in your hosting provider (e.g. Vercel Environment Variables) for production.
# Use test keys during development (sk_test_...) and switch to live keys (sk_live_...) when deploying.
STRIPE_SECRET_KEY=

# Webhook signing secret used to verify incoming Stripe webhook requests.
# Keep this private and only configure it on the backend. Do NOT expose this to the frontend.
STRIPE_WEBHOOK_SECRET=""

# Reminder for production deploys (Vercel):
# - Add STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET in the Vercel dashboard under Project → Settings → Environment Variables.
# - Set NODE_ENV=production and FRONTEND_URL to your production URL.
# - Replace test keys with live keys before enabling production traffic.